node_modules/
dist/
.env
.env.local
*.log
.DS_Store
test-results/
playwright-report/

# Python bytecode
__pycache__/
*.pyc

# Processing workspace (work/).
# Hand-written study scripts and notes stay in Git; everything they generate
# (rasters, arrays, study reports, screenshots) stays local. Curated evidence
# belongs in docs/, runtime data in src/lib/data/. See docs/claude-progress.md
# ("Git recovery") for the data workflow.
work/**
!work/**/
!work/**/*.py
!work/**/*.mjs
!work/**/*.md
!work/**/*.txt
# Full app snapshots taken before each step (local before/after reference only).
work/*/before-app/
work/*/optionB-app/
work/*/before-snapshot/
work/coordinate-migration-backup/

# Raw survey deliveries; preserve metadata locally, publish only with verified licence.
work/geodata/

# Step 5 / 5.1 measurement scratch (app snapshots, benchmark runs, captures, probe output,
# backups). Curated evidence is in docs/step5*/; the reusable tools are in scripts/geo/.
/work/step5/
/work/step51/
/work/step51opt/
# Step 6 measurement scratch (baseline app snapshot, benchmark runs, captures, LiDAR probes).
# Curated evidence is in docs/step6/; reusable tools are in scripts/.
/work/step6/

# Step 6.2 read-only research scratch, including local validator dependencies.
/work/step62/

# Lighting Phase 0 scratch (baseline app snapshot, raw captures, perf runs). Curated evidence is in
# docs/lighting-phase0/; reusable tools are in scripts/lighting-phase0/.
/work/lighting-phase0/

# Lighting Phase A1 scratch (Phase 0 snapshot, before/after apps, raw captures, perf runs). Curated evidence is
# in docs/lighting-phase-a1/; reusable tools are in scripts/lighting-a1/.
/work/lighting-a1/

# Lighting Phase A2 scratch (A1 reference app, raw captures, perf runs, exploration). Curated evidence is
# in docs/lighting-phase-a2/; reusable tools are in scripts/lighting-a2/.
/work/lighting-a2/
